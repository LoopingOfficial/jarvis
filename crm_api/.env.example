# Copier vers .env et renseigner. Ne jamais commiter le .env rempli.
# cPanel préfixe base et utilisateur par le nom du compte.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moncompte_crm
DB_USER=moncompte_crmuser
DB_PASSWORD=
# Clé partagée présentée par l'assistant dans l'en-tête X-API-Key.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
CRM_API_KEY=
# Journaliser le SQL émis (1 = oui). À laisser à 0 en production.
SQL_ECHO=0
# Origines navigateur autorisées, séparées par des virgules. Vide = aucune.
CORS_ORIGINS=
